rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin checking function
    // Modify this if you use custom claims or a specific admin collection
    function isAdmin() {
      return request.auth != null; // Simplified admin check. For production verify claims!
    }

    // Media Collection
    match /media/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Settings Collection
    match /settings/{document=**} {
      // Allowed for public storefront to read config (contact, social, branding, preloader)
      allow read: if true;
      allow write: if isAdmin();
    }

    // Page Headers Collection
    match /page_headers/{document=**} {
      // Allowed for public storefront to read header mapping
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services Collection
    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // About Section
    match /about_section/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /about/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Blog Collection
    match /blogs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Guides Collection
    match /guides/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // FAQs Collection
    match /faqs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials Collection
    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
